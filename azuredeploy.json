{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Notifica Microsoft Teams alla creazione di un incident Microsoft Sentinel",
        "description": "Playbook (Logic App) avviato dal trigger incident di Microsoft Sentinel. Invia una Adaptive Card con i dettagli dell'incident (gravità, stato, proprietario, date, tattiche/tecniche MITRE, prodotti, descrizione, alert, entità e link ai portali) in chat Teams a un elenco di utenti e, facoltativamente, in un canale Teams e/o a un webhook Workflows di Teams.",
        "prerequisites": [
            "Un account Microsoft Teams con cui autorizzare la connessione API Teams (per pubblicare in un canale, l'account deve essere membro del team).",
            "L'app Teams 'Workflows' (ex Power Automate) deve essere consentita nell'interfaccia di amministrazione di Teams.",
            "I destinatari devono essere utenti (UPN/email) del tenant: le liste di distribuzione non sono supportate nella chat con il bot."
        ],
        "postDeployment": [
            "1. Autorizzare la connessione API 'teams-<PlaybookName>' (Connessione API > Modifica connessione API > Autorizza > Salva).",
            "2. Se AzureSecurityInsightsObjectId non è stato indicato, concedere a Microsoft Sentinel il ruolo 'Microsoft Sentinel Automation Contributor' sul resource group del playbook (Impostazioni > Autorizzazioni playbook).",
            "3. Se WorkspaceName non è stato indicato, creare un'automation rule con trigger 'Quando viene creato un incident' e azione 'Esegui playbook'."
        ],
        "lastUpdateTime": "2026-11-02T00:00:00.000Z",
        "entities": [],
        "tags": [ "Notification", "Teams", "Incident Trigger" ],
        "support": {
            "tier": "community"
        }
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Notifica-Teams-Nuovo-Incident",
            "minLength": 1,
            "maxLength": 64,
            "metadata": {
                "description": "Nome del playbook (Logic App) da creare."
            }
        },
        "TeamsRecipients": {
            "type": "string",
            "defaultValue": "analista.soc1@contoso.com;analista.soc2@contoso.com",
            "metadata": {
                "description": "Utenti che ricevono la card in chat Teams: UPN/email separati da ';'. Gli indirizzi predefiniti sono fittizi e vanno sostituiti. Lasciare vuoto per pubblicare solo nel canale."
            }
        },
        "TeamsTeamId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "(Facoltativo) ID del team (groupId) in cui pubblicare la card. Va indicato insieme a TeamsChannelId."
            }
        },
        "TeamsChannelId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "(Facoltativo) ID del canale standard (es. 19:xxxx@thread.tacv2) in cui pubblicare la card. Va indicato insieme a TeamsTeamId."
            }
        },
        "TeamsWebhookUrl": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "(Facoltativo) URL di un webhook Workflows di Teams (modello 'Invia avvisi webhook a una chat' o 'a un canale'). Se valorizzato, la card viene inviata anche al webhook, senza usare la connessione Teams."
            }
        },
        "TimeZone": {
            "type": "string",
            "defaultValue": "W. Europe Standard Time",
            "metadata": {
                "description": "Fuso orario (nome Windows) con cui mostrare le date nella card."
            }
        },
        "WorkspaceName": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "(Facoltativo) Nome del workspace Log Analytics con Microsoft Sentinel. Se valorizzato, viene creata l'automation rule che esegue il playbook alla creazione di ogni incident."
            }
        },
        "WorkspaceResourceGroup": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]",
            "metadata": {
                "description": "(Facoltativo) Resource group del workspace di Microsoft Sentinel. Predefinito: lo stesso resource group del playbook."
            }
        },
        "AzureSecurityInsightsObjectId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "(Facoltativo) Object ID del service principal 'Azure Security Insights' nel tenant. Se valorizzato, assegna a Microsoft Sentinel il ruolo 'Microsoft Sentinel Automation Contributor' sul resource group del playbook. Lasciare vuoto se il permesso è già stato concesso."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Area geografica delle risorse."
            }
        }
    },
    "variables": {
        "SentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
        "TeamsConnectionName": "[concat('teams-', parameters('PlaybookName'))]",
        "SentinelAutomationContributorRoleId": "f4c81013-99ee-4d62-a7ee-b3f1f648599a",
        "AutomationRuleName": "[guid(subscription().id, parameters('WorkspaceResourceGroup'), parameters('WorkspaceName'), parameters('PlaybookName'))]",
        "AutomationRuleDisplayName": "[concat('Notifica Teams su nuovo incident (', parameters('PlaybookName'), ')')]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('SentinelConnectionName')]",
            "location": "[parameters('location')]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('SentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('TeamsConnectionName')]",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "[variables('TeamsConnectionName')]",
                "customParameterValues": {},
                "api": {
                    "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[parameters('location')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
                "[resourceId('Microsoft.Web/connections', variables('TeamsConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "TeamsRecipients": {
                            "defaultValue": "[parameters('TeamsRecipients')]",
                            "type": "String"
                        },
                        "TeamsTeamId": {
                            "defaultValue": "[parameters('TeamsTeamId')]",
                            "type": "String"
                        },
                        "TeamsChannelId": {
                            "defaultValue": "[parameters('TeamsChannelId')]",
                            "type": "String"
                        },
                        "TeamsWebhookUrl": {
                            "defaultValue": "",
                            "type": "SecureString"
                        },
                        "TimeZone": {
                            "defaultValue": "[parameters('TimeZone')]",
                            "type": "String"
                        },
                        "TenantId": {
                            "defaultValue": "[subscription().tenantId]",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Incident": {
                            "runAfter": {},
                            "type": "Compose",
                            "inputs": "@triggerBody()?['object']?['properties']"
                        },
                        "Compose_defender_url": {
                            "runAfter": {
                                "Incident": [ "Succeeded" ]
                            },
                            "type": "Compose",
                            "inputs": "@{if(not(empty(coalesce(outputs('Incident')?['additionalData']?['providerIncidentUrl'], ''))), coalesce(outputs('Incident')?['additionalData']?['providerIncidentUrl'], ''), if(and(contains(createArray('Microsoft XDR', 'Microsoft 365 Defender', 'Microsoft Defender XDR'), coalesce(outputs('Incident')?['providerName'], '')), not(empty(string(coalesce(outputs('Incident')?['providerIncidentId'], ''))))), concat('https://security.microsoft.com/incident2/', string(coalesce(outputs('Incident')?['providerIncidentId'], '')), '/overview?tid=', parameters('TenantId')), ''))}"
                        },
                        "Compose_incident_details": {
                            "runAfter": {
                                "Compose_defender_url": [ "Succeeded" ]
                            },
                            "type": "Compose",
                            "inputs": {
                                "incidentNumber": "@{outputs('Incident')?['incidentNumber']}",
                                "title": "@{coalesce(outputs('Incident')?['title'], 'Incident senza titolo')}",
                                "severity": "@{if(equals(outputs('Incident')?['severity'], 'High'), '🔴 Alta', if(equals(outputs('Incident')?['severity'], 'Medium'), '🟠 Media', if(equals(outputs('Incident')?['severity'], 'Low'), '🟡 Bassa', '🔵 Informativa')))}",
                                "headerStyle": "@{if(equals(outputs('Incident')?['severity'], 'High'), 'attention', if(equals(outputs('Incident')?['severity'], 'Medium'), 'warning', if(equals(outputs('Incident')?['severity'], 'Low'), 'accent', 'emphasis')))}",
                                "headerColor": "@{if(equals(outputs('Incident')?['severity'], 'High'), 'attention', if(equals(outputs('Incident')?['severity'], 'Medium'), 'warning', if(equals(outputs('Incident')?['severity'], 'Low'), 'accent', 'default')))}",
                                "status": "@{if(equals(outputs('Incident')?['status'], 'New'), 'Nuovo', if(equals(outputs('Incident')?['status'], 'Active'), 'Attivo', if(equals(outputs('Incident')?['status'], 'Closed'), 'Chiuso', coalesce(outputs('Incident')?['status'], 'N/D'))))}",
                                "owner": "@{if(empty(coalesce(outputs('Incident')?['owner']?['assignedTo'], outputs('Incident')?['owner']?['email'], '')), 'Non assegnato', coalesce(outputs('Incident')?['owner']?['assignedTo'], outputs('Incident')?['owner']?['email'], ''))}",
                                "created": "@{convertFromUtc(coalesce(outputs('Incident')?['createdTimeUtc'], utcNow()), parameters('TimeZone'), 'dd/MM/yyyy HH:mm:ss')}",
                                "firstActivity": "@{convertFromUtc(coalesce(outputs('Incident')?['firstActivityTimeUtc'], outputs('Incident')?['createdTimeUtc'], utcNow()), parameters('TimeZone'), 'dd/MM/yyyy HH:mm:ss')}",
                                "lastActivity": "@{convertFromUtc(coalesce(outputs('Incident')?['lastActivityTimeUtc'], outputs('Incident')?['createdTimeUtc'], utcNow()), parameters('TimeZone'), 'dd/MM/yyyy HH:mm:ss')}",
                                "alertsCount": "@{coalesce(outputs('Incident')?['additionalData']?['alertsCount'], length(coalesce(outputs('Incident')?['Alerts'], json('[]'))))}",
                                "entitiesCount": "@{length(coalesce(outputs('Incident')?['relatedEntities'], json('[]')))}",
                                "products": "@{if(empty(coalesce(outputs('Incident')?['additionalData']?['alertProductNames'], json('[]'))), 'N/D', join(coalesce(outputs('Incident')?['additionalData']?['alertProductNames'], json('[]')), ', '))}",
                                "tactics": "@{if(empty(coalesce(outputs('Incident')?['additionalData']?['tactics'], json('[]'))), 'N/D', join(coalesce(outputs('Incident')?['additionalData']?['tactics'], json('[]')), ', '))}",
                                "techniques": "@{if(empty(coalesce(outputs('Incident')?['additionalData']?['techniques'], json('[]'))), 'N/D', join(coalesce(outputs('Incident')?['additionalData']?['techniques'], json('[]')), ', '))}",
                                "provider": "@{coalesce(outputs('Incident')?['providerName'], 'Microsoft Sentinel')}@{if(or(empty(outputs('Compose_defender_url')), empty(string(coalesce(outputs('Incident')?['providerIncidentId'], '')))), '', concat(' (ID Defender ', string(coalesce(outputs('Incident')?['providerIncidentId'], '')), ')'))}",
                                "workspace": "@{coalesce(triggerBody()?['workspaceInfo']?['WorkspaceName'], 'N/D')}",
                                "description": "@{if(empty(coalesce(outputs('Incident')?['description'], '')), 'Nessuna descrizione disponibile.', concat(substring(coalesce(outputs('Incident')?['description'], ''), 0, min(length(coalesce(outputs('Incident')?['description'], '')), 1500)), if(greater(length(coalesce(outputs('Incident')?['description'], '')), 1500), '…', '')))}",
                                "incidentUrl": "@{coalesce(outputs('Incident')?['incidentUrl'], 'https://portal.azure.com')}",
                                "defenderUrl": "@{outputs('Compose_defender_url')}",
                                "hasDefenderUrl": "@not(empty(outputs('Compose_defender_url')))"
                            }
                        },
                        "Select_alerts": {
                            "runAfter": {
                                "Incident": [ "Succeeded" ]
                            },
                            "type": "Select",
                            "inputs": {
                                "from": "@take(coalesce(outputs('Incident')?['Alerts'], json('[]')), 10)",
                                "select": {
                                    "title": "@{if(equals(item()?['properties']?['severity'], 'High'), '🔴 Alta', if(equals(item()?['properties']?['severity'], 'Medium'), '🟠 Media', if(equals(item()?['properties']?['severity'], 'Low'), '🟡 Bassa', '🔵 Info')))}",
                                    "value": "@{coalesce(item()?['properties']?['alertDisplayName'], item()?['properties']?['friendlyName'], 'Alert')}@{if(empty(coalesce(item()?['properties']?['productName'], '')), '', concat(' (', coalesce(item()?['properties']?['productName'], ''), ')'))}"
                                }
                            }
                        },
                        "Select_entities": {
                            "runAfter": {
                                "Incident": [ "Succeeded" ]
                            },
                            "type": "Select",
                            "inputs": {
                                "from": "@take(coalesce(outputs('Incident')?['relatedEntities'], json('[]')), 15)",
                                "select": {
                                    "title": "@{coalesce(item()?['kind'], 'Entità')}",
                                    "value": "@{coalesce(item()?['properties']?['friendlyName'], item()?['name'], '-')}"
                                }
                            }
                        },
                        "Compose_adaptive_card": {
                            "runAfter": {
                                "Compose_incident_details": [ "Succeeded" ],
                                "Select_alerts": [ "Succeeded" ],
                                "Select_entities": [ "Succeeded" ]
                            },
                            "type": "Compose",
                            "inputs": {
                                "type": "AdaptiveCard",
                                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                                "version": "1.4",
                                "msteams": {
                                    "width": "Full"
                                },
                                "body": [
                                    {
                                        "type": "Container",
                                        "style": "@{outputs('Compose_incident_details')?['headerStyle']}",
                                        "bleed": true,
                                        "items": [
                                            {
                                                "type": "TextBlock",
                                                "text": "🚨 Nuovo incident Microsoft Sentinel",
                                                "color": "@{outputs('Compose_incident_details')?['headerColor']}",
                                                "size": "Medium",
                                                "weight": "Bolder",
                                                "wrap": true
                                            },
                                            {
                                                "type": "TextBlock",
                                                "text": "Incident @{outputs('Compose_incident_details')?['incidentNumber']}: @{outputs('Compose_incident_details')?['title']}",
                                                "size": "Large",
                                                "weight": "Bolder",
                                                "spacing": "Small",
                                                "wrap": true
                                            }
                                        ]
                                    },
                                    {
                                        "type": "FactSet",
                                        "spacing": "Medium",
                                        "facts": [
                                            {
                                                "title": "Gravità",
                                                "value": "@{outputs('Compose_incident_details')?['severity']}"
                                            },
                                            {
                                                "title": "Stato",
                                                "value": "@{outputs('Compose_incident_details')?['status']}"
                                            },
                                            {
                                                "title": "Proprietario",
                                                "value": "@{outputs('Compose_incident_details')?['owner']}"
                                            },
                                            {
                                                "title": "Creato il",
                                                "value": "@{outputs('Compose_incident_details')?['created']}"
                                            },
                                            {
                                                "title": "Prima attività",
                                                "value": "@{outputs('Compose_incident_details')?['firstActivity']}"
                                            },
                                            {
                                                "title": "Ultima attività",
                                                "value": "@{outputs('Compose_incident_details')?['lastActivity']}"
                                            },
                                            {
                                                "title": "Numero di alert",
                                                "value": "@{outputs('Compose_incident_details')?['alertsCount']}"
                                            },
                                            {
                                                "title": "Prodotti",
                                                "value": "@{outputs('Compose_incident_details')?['products']}"
                                            },
                                            {
                                                "title": "Tattiche MITRE",
                                                "value": "@{outputs('Compose_incident_details')?['tactics']}"
                                            },
                                            {
                                                "title": "Tecniche MITRE",
                                                "value": "@{outputs('Compose_incident_details')?['techniques']}"
                                            },
                                            {
                                                "title": "Origine",
                                                "value": "@{outputs('Compose_incident_details')?['provider']}"
                                            },
                                            {
                                                "title": "Workspace",
                                                "value": "@{outputs('Compose_incident_details')?['workspace']}"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "Orari espressi nel fuso: @{parameters('TimeZone')}",
                                        "size": "Small",
                                        "isSubtle": true,
                                        "spacing": "Small",
                                        "wrap": true
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "Descrizione",
                                        "weight": "Bolder",
                                        "separator": true,
                                        "spacing": "Medium",
                                        "wrap": true
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "@{outputs('Compose_incident_details')?['description']}",
                                        "spacing": "Small",
                                        "wrap": true
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "Alert correlati (@{length(body('Select_alerts'))} di @{outputs('Compose_incident_details')?['alertsCount']})",
                                        "weight": "Bolder",
                                        "separator": true,
                                        "spacing": "Medium",
                                        "wrap": true,
                                        "isVisible": "@greater(length(body('Select_alerts')), 0)"
                                    },
                                    {
                                        "type": "FactSet",
                                        "spacing": "Small",
                                        "facts": "@body('Select_alerts')",
                                        "isVisible": "@greater(length(body('Select_alerts')), 0)"
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "Entità coinvolte (@{length(body('Select_entities'))} di @{outputs('Compose_incident_details')?['entitiesCount']})",
                                        "weight": "Bolder",
                                        "separator": true,
                                        "spacing": "Medium",
                                        "wrap": true,
                                        "isVisible": "@greater(length(body('Select_entities')), 0)"
                                    },
                                    {
                                        "type": "FactSet",
                                        "spacing": "Small",
                                        "facts": "@body('Select_entities')",
                                        "isVisible": "@greater(length(body('Select_entities')), 0)"
                                    },
                                    {
                                        "type": "Container",
                                        "separator": true,
                                        "spacing": "Medium",
                                        "items": [
                                            {
                                                "type": "TextBlock",
                                                "text": "ℹ️ Questo incident non è presente nel portale Microsoft Defender: ad esempio è stato creato manualmente oppure il workspace non è collegato a Defender.",
                                                "size": "Small",
                                                "isSubtle": true,
                                                "wrap": true,
                                                "isVisible": "@not(outputs('Compose_incident_details')?['hasDefenderUrl'])"
                                            },
                                            {
                                                "type": "ActionSet",
                                                "isVisible": "@outputs('Compose_incident_details')?['hasDefenderUrl']",
                                                "actions": [
                                                    {
                                                        "type": "Action.OpenUrl",
                                                        "title": "Apri l'incident nel portale Microsoft Defender",
                                                        "url": "@{if(outputs('Compose_incident_details')?['hasDefenderUrl'], outputs('Compose_incident_details')?['defenderUrl'], 'https://security.microsoft.com/incidents')}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "ActionSet",
                                                "actions": [
                                                    {
                                                        "type": "Action.OpenUrl",
                                                        "title": "Apri l'incident nel portale Azure",
                                                        "url": "@{outputs('Compose_incident_details')?['incidentUrl']}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        "Filter_recipients": {
                            "runAfter": {
                                "Compose_adaptive_card": [ "Succeeded" ]
                            },
                            "type": "Query",
                            "inputs": {
                                "from": "@split(replace(replace(parameters('TeamsRecipients'), ',', ';'), ' ', ''), ';')",
                                "where": "@not(empty(item()))"
                            }
                        },
                        "For_each_recipient": {
                            "runAfter": {
                                "Filter_recipients": [ "Succeeded" ]
                            },
                            "type": "Foreach",
                            "foreach": "@body('Filter_recipients')",
                            "actions": {
                                "Post_card_in_chat_with_Flow_bot": {
                                    "runAfter": {},
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['teams']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "recipient": "@{items('For_each_recipient')}",
                                            "messageBody": "@{outputs('Compose_adaptive_card')}"
                                        },
                                        "path": "/v1.0/teams/conversation/adaptivecard/poster/Flow bot/location/@{encodeURIComponent('Chat with Flow bot')}"
                                    }
                                }
                            }
                        },
                        "Condition_post_to_channel": {
                            "runAfter": {
                                "Compose_adaptive_card": [ "Succeeded" ]
                            },
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "not": {
                                            "equals": [ "@trim(parameters('TeamsTeamId'))", "" ]
                                        }
                                    },
                                    {
                                        "not": {
                                            "equals": [ "@trim(parameters('TeamsChannelId'))", "" ]
                                        }
                                    }
                                ]
                            },
                            "actions": {
                                "Post_card_in_channel": {
                                    "runAfter": {},
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['teams']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "recipient": {
                                                "groupId": "@{trim(parameters('TeamsTeamId'))}",
                                                "channelId": "@{trim(parameters('TeamsChannelId'))}"
                                            },
                                            "messageBody": "@{outputs('Compose_adaptive_card')}"
                                        },
                                        "path": "/v1.0/teams/conversation/adaptivecard/poster/Flow bot/location/@{encodeURIComponent('Channel')}"
                                    }
                                }
                            },
                            "else": {
                                "actions": {}
                            }
                        },
                        "Condition_post_to_webhook": {
                            "runAfter": {
                                "Compose_adaptive_card": [ "Succeeded" ]
                            },
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "not": {
                                            "equals": [ "@trim(parameters('TeamsWebhookUrl'))", "" ]
                                        }
                                    }
                                ]
                            },
                            "actions": {
                                "Post_card_to_Teams_webhook": {
                                    "runAfter": {},
                                    "type": "Http",
                                    "inputs": {
                                        "method": "POST",
                                        "uri": "@{trim(parameters('TeamsWebhookUrl'))}",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "type": "message",
                                            "attachments": [
                                                {
                                                    "contentType": "application/vnd.microsoft.card.adaptive",
                                                    "contentUrl": null,
                                                    "content": "@outputs('Compose_adaptive_card')"
                                                }
                                            ]
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {}
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "TeamsWebhookUrl": {
                        "value": "[parameters('TeamsWebhookUrl')]"
                    },
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
                                "connectionName": "[variables('SentinelConnectionName')]",
                                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            },
                            "teams": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('TeamsConnectionName'))]",
                                "connectionName": "[variables('TeamsConnectionName')]",
                                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
                            }
                        }
                    }
                }
            }
        },
        {
            "condition": "[not(empty(parameters('AzureSecurityInsightsObjectId')))]",
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceGroup().id, parameters('AzureSecurityInsightsObjectId'), variables('SentinelAutomationContributorRoleId'))]",
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('SentinelAutomationContributorRoleId'))]",
                "principalId": "[parameters('AzureSecurityInsightsObjectId')]",
                "principalType": "ServicePrincipal",
                "description": "Consente a Microsoft Sentinel di eseguire, tramite automation rule, i playbook di questo resource group."
            }
        },
        {
            "condition": "[not(empty(parameters('WorkspaceName')))]",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "name": "[take(concat('AutomationRule-', parameters('PlaybookName')), 64)]",
            "resourceGroup": "[parameters('WorkspaceResourceGroup')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, parameters('AzureSecurityInsightsObjectId'), variables('SentinelAutomationContributorRoleId')))]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('WorkspaceName')]"
                    },
                    "automationRuleName": {
                        "value": "[variables('AutomationRuleName')]"
                    },
                    "automationRuleDisplayName": {
                        "value": "[variables('AutomationRuleDisplayName')]"
                    },
                    "logicAppResourceId": {
                        "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
                    },
                    "tenantId": {
                        "value": "[subscription().tenantId]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "workspaceName": {
                            "type": "string"
                        },
                        "automationRuleName": {
                            "type": "string"
                        },
                        "automationRuleDisplayName": {
                            "type": "string"
                        },
                        "logicAppResourceId": {
                            "type": "string"
                        },
                        "tenantId": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "type": "Microsoft.SecurityInsights/automationRules",
                            "apiVersion": "2025-09-01",
                            "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                            "name": "[parameters('automationRuleName')]",
                            "properties": {
                                "displayName": "[parameters('automationRuleDisplayName')]",
                                "order": 100,
                                "triggeringLogic": {
                                    "isEnabled": true,
                                    "triggersOn": "Incidents",
                                    "triggersWhen": "Created",
                                    "conditions": []
                                },
                                "actions": [
                                    {
                                        "order": 1,
                                        "actionType": "RunPlaybook",
                                        "actionConfiguration": {
                                            "logicAppResourceId": "[parameters('logicAppResourceId')]",
                                            "tenantId": "[parameters('tenantId')]"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ],
    "outputs": {
        "playbookResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
        },
        "teamsConnectionToAuthorize": {
            "type": "string",
            "value": "[variables('TeamsConnectionName')]"
        },
        "automationRuleCreated": {
            "type": "bool",
            "value": "[not(empty(parameters('WorkspaceName')))]"
        }
    }
}
